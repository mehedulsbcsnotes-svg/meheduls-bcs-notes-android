
<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mehedul's BCS Notes</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary-green: #16A34A;
            --primary-orange: #FB7A1B;
        }
    </style>
</head>
<body class="bg-gray-100 font-sans pb-16">

    <!-- Header Section -->
    <div class="bg-white p-4 shadow-sm flex justify-between items-center sticky top-0 z-50">
        <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-full bg-green-600 flex items-center justify-center text-white font-bold">🌼</div>
            <h1 class="font-bold text-lg text-gray-800">Mehedul's BCS Notes</h1>
        </div>
        <i class="fa-regular fa-bell text-gray-600 text-xl"></i>
    </div>

    <!-- Banner -->
    <div class="m-4 p-4 rounded-xl text-white relative overflow-hidden" style="background: linear-gradient(135deg, #16A34A, #15803d);">
        <p class="text-xs bg-black/20 inline-block px-2 py-1 rounded">স্বাগতম!</p>
        <h2 class="text-lg font-bold mt-1">BCS প্রস্তুতির পথে আপনার সঙ্গী</h2>
        <p class="text-xs mt-2 italic">“স্বপ্ন দেখুন, পরিশ্রম করুন, সফল হবেনই!”</p>
    </div>

    <!-- Quick Buttons -->
    <div class="grid grid-cols-4 gap-2 mx-4 my-4 text-center">
        <div class="bg-white p-3 rounded-lg shadow-sm">
            <i class="fa-solid fa-file-pen text-orange-500 text-xl"></i>
            <p class="text-xs mt-1 font-semibold">MCQ পরীক্ষা</p>
        </div>
        <div class="bg-white p-3 rounded-lg shadow-sm">
            <i class="fa-solid fa-book-open text-green-600 text-xl"></i>
            <p class="text-xs mt-1 font-semibold">বিষয়ভিত্তিক নোট</p>
        </div>
        <div class="bg-white p-3 rounded-lg shadow-sm">
            <i class="fa-solid fa-star text-orange-500 text-xl"></i>
            <p class="text-xs mt-1 font-semibold">গুরুত্বপূর্ণ বিষয়</p>
        </div>
        <div class="bg-white p-3 rounded-lg shadow-sm">
            <i class="fa-solid fa-chart-line text-green-600 text-xl"></i>
            <p class="text-xs mt-1 font-semibold">আমার ফলাফল</p>
        </div>
    </div>

    <!-- Subject List -->
    <div class="mx-4">
        <h3 class="font-bold text-gray-700 mb-2">বিষয়সমূহ</h3>
        
        <!-- Subject Card -->
        <div class="bg-white p-3 rounded-lg shadow-sm mb-2 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg bg-green-100 text-green-600 flex items-center justify-center font-bold">
                    <i class="fa-solid fa-book"></i>
                </div>
                <div>
                    <h4 class="font-semibold text-sm">বাংলা</h4>
                    <p class="text-xs text-gray-500">নোট + MCQ</p>
                </div>
            </div>
            <i class="fa-solid fa-chevron-right text-gray-400"></i>
        </div>

        <div class="bg-white p-3 rounded-lg shadow-sm mb-2 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg bg-orange-100 text-orange-500 flex items-center justify-center font-bold">
                    <i class="fa-solid fa-language"></i>
                </div>
                <div>
                    <h4 class="font-semibold text-sm">ইংরেজি</h4>
                    <p class="text-xs text-gray-500">নোট + MCQ</p>
                </div>
            </div>
            <i class="fa-solid fa-chevron-right text-gray-400"></i>
        </div>
    </div>

    <!-- Bottom Navigation Bar -->
    <div class="fixed bottom-0 left-0 right-0 bg-white border-t flex justify-around py-2 text-center text-gray-600 text-xs">
        <div class="text-green-600"><i class="fa-solid fa-house text-base"></i><br>হোম</div>
        <div><i class="fa-solid fa-book-bookmark text-base"></i><br>নোট</div>
        <div><i class="fa-solid fa-circle-question text-base"></i><br>MCQ</div>
        <div><i class="fa-solid fa-user text-base"></i><br>প্রোফাইল</div>
    </div>

</body>
</html>
